rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId && request.auth.token.email_verified == true;
    }

    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'donistudioproduction@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /users/{userId} {
      allow read, create, update, delete: if signedInAs(userId);

      match /businesses/{businessId} {
        allow read, create, update, delete: if signedInAs(userId);
      }

      match /{document=**} {
        allow read, write: if signedInAs(userId);
      }
    }

    match /userProfiles/{userId} {
      allow read: if signedInAs(userId) || isOwner();
      allow create: if signedInAs(userId);
      allow update: if signedInAs(userId) || isOwner();
      allow delete: if signedInAs(userId) || isOwner();
    }

    match /ownerTopUps/{documentId} {
      allow read: if isOwner() || (request.auth != null && request.auth.token.email_verified == true && resource.data.targetUid == request.auth.uid);
      allow create, update, delete: if isOwner();
    }

    match /userWallets/{userId} {
      allow read: if signedInAs(userId) || isOwner();
      allow create, update: if isOwner();
      allow delete: if isOwner();
    }

    match /ownerCreditTransactions/{transactionId} {
      allow read: if isOwner();
      allow create: if isOwner();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
