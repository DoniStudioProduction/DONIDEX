rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) { return request.auth != null && request.auth.uid == userId && request.auth.token.email_verified == true; }
    function isOwner() { return request.auth != null && request.auth.token.email == 'donistudioproduction@gmail.com' && request.auth.token.email_verified == true; }
    function teamMember(ownerUid) { return request.auth != null && request.auth.token.email_verified == true && exists(/databases/$(database)/documents/teamMemberships/$(request.auth.uid)) && get(/databases/$(database)/documents/teamMemberships/$(request.auth.uid)).data.ownerUid == ownerUid && get(/databases/$(database)/documents/teamMemberships/$(request.auth.uid)).data.status == 'active'; }
    function teamAdmin(ownerUid) { return teamMember(ownerUid) && get(/databases/$(database)/documents/teamMemberships/$(request.auth.uid)).data.role == 'admin'; }

    match /users/{userId} {
      allow read: if signedInAs(userId) || teamMember(userId);
      allow create, update, delete: if signedInAs(userId) || teamAdmin(userId);
      match /businesses/{businessId} {
        allow read: if signedInAs(userId) || teamMember(userId);
        allow create, update, delete: if signedInAs(userId) || teamAdmin(userId);
      }
      match /{document=**} {
        allow read: if signedInAs(userId) || teamMember(userId);
        allow write: if signedInAs(userId) || teamAdmin(userId);
      }
    }

    match /userProfiles/{userId} {
      allow read: if signedInAs(userId) || isOwner();
      allow create, update, delete: if signedInAs(userId) || isOwner();
    }

    match /teamInvites/{inviteId} {
      allow read: if isOwner() || (request.auth != null && request.auth.token.email_verified == true && resource.data.email == request.auth.token.email);
      allow create: if signedInAs(request.resource.data.ownerUid) && request.resource.data.status == 'pending';
      allow update: if isOwner() || (request.auth != null && request.auth.token.email_verified == true && resource.data.email == request.auth.token.email && resource.data.status == 'pending' && request.resource.data.status == 'accepted' && request.resource.data.acceptedUid == request.auth.uid);
      allow delete: if isOwner();
    }

    match /teamMemberships/{userId} {
      allow read: if signedInAs(userId) || isOwner();
      allow create: if signedInAs(userId) && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'active' && get(/databases/$(database)/documents/teamInvites/$(request.resource.data.inviteId)).data.email == request.auth.token.email && get(/databases/$(database)/documents/teamInvites/$(request.resource.data.inviteId)).data.status == 'pending';
      allow update: if isOwner();
      allow delete: if isOwner() || signedInAs(userId);
    }

    match /ownerTopUps/{userId} { allow read: if isOwner() || signedInAs(userId); allow create, update, delete: if isOwner(); }
    match /ownerSubscriptionAudit/{auditId} { allow read, create: if isOwner(); allow update, delete: if false; }
    match /userWallets/{userId} { allow read: if signedInAs(userId) || isOwner(); allow create, update, delete: if isOwner(); }
    match /ownerCreditTransactions/{transactionId} { allow read, create: if isOwner(); allow update, delete: if false; }

    match /sharedDocuments/{token} {
      allow get: if resource.data.published == true;
      allow create: if signedInAs(request.resource.data.ownerUid);
      allow update, delete: if signedInAs(resource.data.ownerUid);
    }

    match /{document=**} { allow read, write: if false; }
  }
}
