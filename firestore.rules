rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId && request.auth.token.email_verified == true;
    }

    match /users/{userId} {
      allow read, create, update, delete: if signedInAs(userId);

      match /businesses/{businessId} {
        allow read, create, update, delete: if signedInAs(userId);
      }

      match /{document=**} {
        allow read, write: if signedInAs(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
